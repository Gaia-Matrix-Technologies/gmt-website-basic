---
import '../styles/global.css';
import company from '../data/company.json';
import { DEFAULT_LANGUAGE, getSupportedLanguage } from '../data/languages.mjs';

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title = `${company.displayName} | Energie neu gedacht`,
  description = "Gaia Matrix Technologies AG entwickelt nanotechnologische Energiesysteme für Photovoltaik, Leuchttechnologie, Heizung und Energiespeicherung.",
  lang = DEFAULT_LANGUAGE,
} = Astro.props;

const toastMessagesByLanguage = {
  de: {
    initial: "Ihre Anfrage wurde vermerkt.",
    sectionOpened: "Bereich geöffnet.",
    requestNoted: "Vielen Dank. Ihre Anfrage wurde vermerkt.",
  },
  en: {
    initial: "Your request has been noted.",
    sectionOpened: "Section opened.",
    requestNoted: "Thank you. Your request has been noted.",
  },
} as const;

const currentLanguage = getSupportedLanguage(lang) as keyof typeof toastMessagesByLanguage;
const toastMessages = toastMessagesByLanguage[currentLanguage] ?? toastMessagesByLanguage[DEFAULT_LANGUAGE as keyof typeof toastMessagesByLanguage];

const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const plausibleScriptSrc = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_SRC ?? "https://plausible.io/js/script.js";
---

<!DOCTYPE html>
<html lang={currentLanguage}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description}>
  <meta name="theme-color" content="#04080e">

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />

  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  {gaMeasurementId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      <script define:vars={{ gaMeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        gtag("js", new Date());
        gtag("config", gaMeasurementId);
      </script>
    </>
  )}

  {plausibleDomain && (
    <script defer data-domain={plausibleDomain} src={plausibleScriptSrc}></script>
  )}
</head>
<body>
  <slot />

  <div
    class="toast"
    id="toast"
    role="status"
    data-section-message={toastMessages.sectionOpened}
    data-submit-message={toastMessages.requestNoted}
  >
    {toastMessages.initial}
  </div>

  <script>
    const toast = document.getElementById("toast");
    const investorForm = document.getElementById("investor-form");
    const links = document.querySelectorAll('a[href^="#"]');
    let toastTimeout: number | undefined;

    function showToast(message: string, duration = 3000) {
      if (!toast) return;
      window.clearTimeout(toastTimeout);

      toast.textContent = message;
      toast.classList.add("visible");

      toastTimeout = window.setTimeout(() => {
        toast.classList.remove("visible");
      }, duration);
    }

    links.forEach((link) => {
      link.addEventListener("click", () => {
        const target = link.getAttribute("href");

        if (target === "#nda" || target === "#contact") {
          showToast(toast?.dataset.sectionMessage ?? "Section opened.");
        }
      });
    });

    if (investorForm) {
      investorForm.addEventListener("submit", (event) => {
        event.preventDefault();

        showToast(
          toast?.dataset.submitMessage ?? "Thank you. Your request has been noted.",
          3500
        );
      });
    }
  </script>
</body>
</html>
