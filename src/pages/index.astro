---
import Layout from '../layouts/Layout.astro';
import company from '../data/company.json';
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from '../data/languages.mjs';
---

<Layout title={company.displayName} lang={DEFAULT_LANGUAGE}>
  <script define:vars={{ defaultLanguage: DEFAULT_LANGUAGE, supportedLanguages: SUPPORTED_LANGUAGES }}>
    (function () {
      try {
        const savedLang = localStorage.getItem('preferred-lang');

        if (supportedLanguages.includes(savedLang)) {
          window.location.replace('/' + savedLang);
          return;
        }

        const userLangs = navigator.languages || [navigator.language || ''];
        const browserLang = userLangs.map(function (lang) {
          return lang.toLowerCase().split('-')[0];
        }).find(function (lang) {
          return supportedLanguages.includes(lang);
        });

        window.location.replace('/' + (browserLang || defaultLanguage));
      } catch (e) {
        window.location.replace('/' + defaultLanguage);
      }
    })();
  </script>

  <noscript>
    <meta http-equiv="refresh" content={`0;url=/${DEFAULT_LANGUAGE}`} />
  </noscript>

  <div style="display: flex; justify-content: center; align-items: center; min-height: 100vh; color: #94a3b8; font-family: sans-serif;">
    <p>Redirecting to your language...</p>
  </div>
</Layout>
