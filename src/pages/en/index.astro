---
import Layout from '../../layouts/Layout.astro';
import Backdrop from '../../components/Backdrop.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Gaia Matrix Technologies AG | Energy rethought" lang="en">
  <Backdrop />

  <div class="page" id="top">
    <Header currentLang="en" />

    <main>
      <!-- Hero -->
      <section class="section hero" id="vision">
        <div class="content">
          <div class="hero-layout">
            <div class="hero-copy">
              <p class="meta">
                Gaia Matrix Technologies / 01
              </p>

              <h1>
                Shaping the future of energy sovereignty requires a clear vision.
              </h1>

              <p class="hero-lede">
                Against the backdrop of geopolitical developments and growing
                environmental challenges, we need an environmentally responsible,
                sustainable, resilient and low-carbon energy supply based on
                renewable energy more than ever.
              </p>

              <div class="actions">
                <a class="action primary" href="#technologies">
                  Our Technologies
                </a>

                <a class="action ghost" href="#nda">
                  Technical Evidence &rarr;
                </a>
              </div>
            </div>

            <div class="stats">
              <div class="stat">
                <strong>2050</strong>
                <span>
                  Europe aims to achieve climate neutrality
                </span>
              </div>

              <div class="stat">
                <strong>04</strong>
                <span>
                  Technology areas: photovoltaics, lighting, heating and storage
                </span>
              </div>

              <div class="stat">
                <strong>100%</strong>
                <span>
                  recyclable design of our products
                </span>
              </div>
            </div>
          </div>

          <div class="instrument">
            <div class="instrument-layout">
              <span class="instrument-label">
                Gaia Matrix Technologies<br>
                Nanotechnology / Energy / Future
              </span>

              <div
                class="graphic"
                aria-label="Abstract illustration of a nanotechnology-based energy system"
                role="img">
              </div>

              <span class="instrument-value">
                Sustainable<br>
                decentralised<br>
                self-sufficient
              </span>
            </div>
          </div>
        </div>
      </section>

      <!-- Vision -->
      <section class="section band">
        <div class="content">
          <div class="section-head">
            <div>
              <p class="meta">
                Our Vision / 02
              </p>

              <h2>
                The era of a new green form of energy generation.
              </h2>
            </div>

            <p>
              Based on the latest nanotechnology research and processes,
              Gaia Matrix Technologies develops systems that rethink energy
              generation and supply. Further technical documentation and
              evidence can be made available to interested parties under an NDA.
            </p>
          </div>

          <div class="items three">
            <article class="item">
              <span class="meta">
                01 / Sustainability
              </span>

              <h3>
                Energy with responsibility.
              </h3>

              <p>
                Our systems are designed for sustainability, environmental
                responsibility, durability, efficiency and low CO₂ emissions.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                02 / Technology
              </span>

              <h3>
                Printed nanotechnology.
              </h3>

              <p>
                Patented and certified systems combine modern nanotechnology
                with a clear, scalable approach to energy generation. Technical
                details can be explored on request in a protected setting.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                03 / Independence
              </span>

              <h3>
                Energy where it is needed.
              </h3>

              <p>
                Decentralised, self-sufficient energy systems create new
                possibilities for buildings, infrastructure and everyday life.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- Technologies -->
      <section class="section" id="technologies">
        <div class="content">
          <div class="platform">
            <div class="platform-intro">
              <p class="meta">
                Technologies / 03
              </p>

              <h2>
                Four areas. One shared vision.
              </h2>

              <p>
                The nanotechnology used by Gaia Matrix Technologies opens up
                new possibilities across different areas of energy generation
                and energy supply.
              </p>

              <p>
                Detailed technical specifications, test documentation and
                further evidence are made available to qualified interested
                parties under an NDA.
              </p>
            </div>

            <div class="list">
              <div class="row">
                <span>01 / Photovoltaics</span>
                <strong>
                  Printed systems for generating electrical energy
                </strong>
              </div>

              <div class="row">
                <span>02 / Lighting Technology</span>
                <strong>
                  Nanotechnology solutions for a new form of lighting
                </strong>
              </div>

              <div class="row">
                <span>03 / Heating</span>
                <strong>
                  Efficient systems for sustainable heat supply
                </strong>
              </div>

              <div class="row">
                <span>04 / Energy Storage</span>
                <strong>
                  Technologies for storing and using self-generated energy
                </strong>
              </div>

              <div class="row">
                <span>Materials</span>
                <strong>
                  Without critical or rare earth elements
                </strong>
              </div>

              <div class="row">
                <span>Product Approach</span>
                <strong>
                  Durable, pollutant-free and fully recyclable
                </strong>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Applications -->
      <section class="section" id="applications">
        <div class="content">
          <div class="section-head">
            <div>
              <p class="meta">
                Applications / 04
              </p>

              <h2>
                Energy becomes part of our environment.
              </h2>
            </div>

            <p>
              Our energy systems can help transform buildings, infrastructure
              and the way we live and work sustainably.
            </p>
          </div>

          <div class="items four">
            <article class="item">
              <span class="meta">
                A / Buildings
              </span>

              <h3>
                Self-sufficient homes
              </h3>

              <p>
                Photovoltaics and energy storage enable buildings to meet
                much of their energy demand independently.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                B / Business
              </span>

              <h3>
                Commercial systems
              </h3>

              <p>
                Decentralised energy supply for businesses and commercial
                buildings, focused on efficiency and long-term cost reduction.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                C / Infrastructure
              </span>

              <h3>
                Decentralised energy
              </h3>

              <p>
                Energy supply becomes less dependent on centralised structures
                and therefore more resilient to crises and shortages.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                D / Everyday Life
              </span>

              <h3>
                New living spaces
              </h3>

              <p>
                Our products are intended for use wherever we live, work and
                need energy every day.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- Independence -->
      <section class="section" id="independence">
        <div class="content">
          <div class="comparison">
            <div class="comparison-copy">
              <p class="meta">
                Energy Independence / 05
              </p>

              <h2>
                Strategic sovereignty starts with energy.
              </h2>

              <p>
                Decentralised, self-sufficient energy supply is at the heart
                of our work. It means strategic sovereignty and independence
                from conventional energy supplied by gas, oil or coal.
              </p>

              <p>
                A resilient energy infrastructure can help ensure that energy
                can no longer be used as a strategic tool of pressure in times
                of crisis.
              </p>

              <p>
                Technical evidence and further documentation on the systems'
                performance can be reviewed after appropriate qualification
                and under an NDA.
              </p>
            </div>

            <div class="table">
              <table>
                <thead>
                  <tr>
                    <th>Dimension</th>
                    <th>Our Approach</th>
                    <th>Objective</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Supply</td>
                    <td class="positive">
                      Decentralised and self-sufficient
                    </td>
                    <td>
                      Greater resilience
                    </td>
                  </tr>
                  <tr>
                    <td>Energy Sources</td>
                    <td class="positive">
                      Renewable energy
                    </td>
                    <td>
                      Less dependence on fossil fuels
                    </td>
                  </tr>
                  <tr>
                    <td>Materials</td>
                    <td class="positive">
                      Without critical or rare earth elements
                    </td>
                    <td>
                      More sustainable production
                    </td>
                  </tr>
                  <tr>
                    <td>Service Life</td>
                    <td class="positive">
                      Durable systems
                    </td>
                    <td>
                      Sustainable use
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Quote -->
      <section class="section">
        <div class="content">
          <div class="quote">
            <blockquote>
              “Our environment, our infrastructure, our homes and the way we
              live will be positively transformed by these energy systems.”
            </blockquote>

            <cite>
              Gaia Matrix Technologies AG / Future Vision
            </cite>
          </div>
        </div>
      </section>

      <!-- Sustainability -->
      <section class="section band">
        <div class="content">
          <div class="section-head">
            <div>
              <p class="meta">
                Materials &amp; Efficiency / 06
              </p>

              <h2>
                Sustainability starts with materials.
              </h2>
            </div>

            <p>
              Our products do not use critical or rare earth elements. They
              are free from harmful substances, durable, affordable and
              designed for low CO₂ emissions and full recyclability.
            </p>
          </div>

          <div class="items three">
            <article class="item">
              <span class="meta">
                01 / Resources
              </span>

              <h3>
                No critical earth elements.
              </h3>

              <p>
                Neither critical nor rare earth elements are used to
                manufacture our products.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                02 / Circularity
              </span>

              <h3>
                Recyclable.
              </h3>

              <p>
                Our systems are fully recyclable and designed for a more
                sustainable product life cycle.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                03 / Commercial Viability
              </span>

              <h3>
                Sustainable and commercially viable.
              </h3>

              <p>
                The products are affordable and designed to recoup the
                investment within a few years.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- Partners -->
      <section class="section">
        <div class="content">
          <div class="opportunity-layout">
            <div class="opportunity-copy">
              <p class="meta">
                Network / 07
              </p>

              <h2>
                Shaping the energy future together.
              </h2>

              <p>
                We are internationally connected through our renowned industry
                partners. If you want to become an integral part of this
                network, we can safeguard the future of current and future
                generations together.
              </p>
            </div>

            <div class="opportunity-action">
              <a class="action secondary" href="#nda">
                Technical Documentation &rarr;
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Future -->
      <section class="section opportunity">
        <div class="content">
          <div class="opportunity-layout">
            <div class="opportunity-copy">
              <p class="meta">
                Future / 08
              </p>

              <h2>
                A quantum leap.
              </h2>

              <p>
                Our nanotechnology is revolutionising energy generation. The
                dream of independence from fossil fuels is becoming reality.
              </p>

              <p>
                We see our approach as the beginning of a journey we would
                like to take with you as customers and/or investors.
              </p>

              <p>
                Future-focused investments in energy independence, environmental
                protection and security are a sound and worthwhile step for
                responsible investors.
              </p>

              <p class="text-mono-small">
                Further technical documentation and evidence are available to
                qualified interested parties after an NDA has been concluded.
              </p>
            </div>

            <div class="opportunity-action">
              <a class="action primary" href="#nda">
                Request Access
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- NDA / Technical Evidence -->
      <section class="section" id="nda">
        <div class="content">
          <div class="nda">
            <div class="nda-intro">
              <p class="meta">
                Technical Evidence / 09
              </p>

              <h2>
                Explore in depth. Under NDA.
              </h2>

              <p>
                We provide interested investors, industry partners and
                qualified cooperation partners with further technical
                information and evidence in a protected setting.
              </p>
            </div>

            <div class="points">
              <div class="point">
                <span>
                  01 / Technical Data
                </span>
                <strong>
                  Further technical specifications and product information can
                  be provided after the request has been reviewed.
                </strong>
              </div>

              <div class="point">
                <span>
                  02 / Evidence
                </span>
                <strong>
                  Available test, inspection, certification and validation
                  documentation can be reviewed as part of the protected
                  information process.
                </strong>
              </div>

              <div class="point">
                <span>
                  03 / Business Model
                </span>
                <strong>
                  Qualified interested parties can receive in-depth information
                  on applications, partnerships and commercial development.
                </strong>
              </div>

              <div class="point">
                <span>
                  04 / Confidentiality
                </span>
                <strong>
                  Access to confidential information is granted following an
                  appropriate review and, where necessary, based on a
                  non-disclosure agreement (NDA).
                </strong>
              </div>
            </div>
          </div>

          <!-- Form -->
          <div class="form-area">
            <div class="form-head">
              <div>
                <p class="meta">
                  Request Access
                </p>

                <h2>
                  Let's start a conversation.
                </h2>
              </div>

              <p>
                Please share some information about your organisation and your
                interest. We will review your request and contact you personally.
              </p>
            </div>

            <form
              class="form"
              id="investor-form"
              action="#"
              method="POST"
            >
              <div class="field">
                <label for="name">
                  Name *
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                >
              </div>

              <div class="field">
                <label for="company">
                  Company / Organisation *
                </label>
                <input
                  id="company"
                  name="company"
                  type="text"
                  autocomplete="organization"
                  required
                >
              </div>

              <div class="field">
                <label for="email">
                  Email *
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                >
              </div>

              <div class="field">
                <label for="country">
                  Country
                </label>
                <input
                  id="country"
                  name="country"
                  type="text"
                  autocomplete="country-name"
                >
              </div>

              <div class="field">
                <label for="type">
                  Organisation Type *
                </label>
                <select
                  id="type"
                  name="organisation_type"
                  required
                >
                  <option value="" selected disabled>
                    Please select
                  </option>
                  <option value="private-investor">
                    Private Investor
                  </option>
                  <option value="institutional-investor">
                    Institutional Investor
                  </option>
                  <option value="family-office">
                    Family Office
                  </option>
                  <option value="corporate">
                    Company / Industry
                  </option>
                  <option value="technology-partner">
                    Technology Partner
                  </option>
                  <option value="other">
                    Other
                  </option>
                </select>
              </div>

              <div class="field">
                <label for="interest">
                  Area of Interest *
                </label>
                <select
                  id="interest"
                  name="interest"
                  required
                >
                  <option value="" selected disabled>
                    Please select
                  </option>
                  <option value="investment">
                    Investment
                  </option>
                  <option value="photovoltaics">
                    Photovoltaics
                  </option>
                  <option value="lighting">
                    Lighting Technology
                  </option>
                  <option value="heating">
                    Heating
                  </option>
                  <option value="energy-storage">
                    Energy Storage
                  </option>
                  <option value="industrial-partnership">
                    Industrial Partnership
                  </option>
                  <option value="commercialisation">
                    Commercialisation
                  </option>
                </select>
              </div>

              <div class="field">
                <label for="investment">
                  Investment / Partnership Interest
                </label>
                <select
                  id="investment"
                  name="investment_interest"
                >
                  <option value="" selected>
                    Please select
                  </option>
                  <option value="exploring">
                    Initial Exploration
                  </option>
                  <option value="serious-interest">
                    Serious Interest
                  </option>
                  <option value="strategic-partnership">
                    Strategic Partnership
                  </option>
                  <option value="investment">
                    Investment Discussion
                  </option>
                  <option value="commercial-partnership">
                    Commercial Collaboration
                  </option>
                </select>
              </div>

              <div class="field">
                <label for="website">
                  Website
                </label>
                <input
                  id="website"
                  name="website"
                  type="url"
                  autocomplete="url"
                  placeholder="https://"
                >
              </div>

              <div class="field full">
                <label for="message">
                  Message
                </label>
                <textarea
                  id="message"
                  name="message"
                  placeholder="Briefly describe your interest or planned collaboration."
                ></textarea>
              </div>

              <div class="check">
                <input
                  id="nda-consent"
                  name="nda_interest"
                  type="checkbox"
                  value="yes"
                  required
                >
                <label for="nda-consent">
                  I would like to receive information about the available
                  technical documentation and evidence, and understand that
                  confidential information may only be provided after an NDA
                  has been concluded.
                </label>
              </div>

              <div class="submit">
                <button
                  class="action primary"
                  type="submit"
                >
                  Send Request
                </button>
                <p class="note">
                  Your details are used to process your request. Before going
                  live, add a link to your privacy policy and adapt this notice
                  to your actual data-processing practices.
                </p>
              </div>
            </form>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="section" id="contact">
        <div class="content">
          <div class="section-head">
            <div>
              <p class="meta">
                Contact / 10
              </p>

              <h2>
                The direction is clear and set.
              </h2>
            </div>

            <p>
              If you would like to become a customer, investor or integral
              part of our international network, we look forward to hearing
              from you.
            </p>
          </div>

          <div class="contacts">
            <article class="contact">
              <span class="contact-role">
                CEO and Co-Founder
              </span>

              <h3>
                Gerlinde Jacobs
              </h3>

              <p class="address">
                GMT Gaia Matrix Technologies AG<br>
                Max-Högger-Strasse 6<br>
                8048 Zürich<br>
                Switzerland
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- Legal Notice -->
      <section class="section legal" id="impressum">
        <div class="content">
          <div class="legal-grid">
            <div class="legal-copy">
              <p class="meta">
                Legal Notice / 11
              </p>

              <h2>
                Legal &amp; Compliance
              </h2>

              <p>
                GMT Gaia Matrix Technologies AG<br>
                Max-Högger-Strasse 6<br>
                8048 Zürich<br>
                Switzerland
              </p>

              <div class="actions" style="margin-top: 24px;">
                <a class="action secondary" href="/en/impressum">
                  Impressum &amp; Company Details &rarr;
                </a>
                <a class="action ghost" href="/en/legal">
                  Privacy Policy &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer currentLang="en" />
  </div>
</Layout>
