---
import Layout from '../../layouts/Layout.astro';
import Backdrop from '../../components/Backdrop.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Gaia Matrix Technologies AG | Energie neu gedacht" lang="de">
  <Backdrop />

  <div class="page" id="top">
    <Header currentLang="de" />

    <main>
      <!-- Hero -->
      <section class="section hero" id="vision">
        <div class="content">
          <div class="hero-layout">
            <div class="hero-copy">
              <p class="meta">
                Gaia Matrix Technologies / 01
              </p>

              <h1>
                Die Gestaltung der Zukunft der Energiesouveränität erfordert eine klare Vorstellung.
              </h1>

              <p class="hero-lede">
                Vor dem Hintergrund geopolitischer Entwicklungen und wachsender
                Umweltprobleme brauchen wir mehr denn je eine umweltfreundliche,
                nachhaltige, resiliente und CO₂-arme Energieversorgung auf Basis
                erneuerbarer Energien.
              </p>

              <div class="actions">
                <a class="action primary" href="#technologies">
                  Unsere Technologien
                </a>

                <a class="action ghost" href="#nda">
                  Technische Evidenz &rarr;
                </a>
              </div>
            </div>

            <div class="stats">
              <div class="stat">
                <strong>2050</strong>
                <span>
                  Europa strebt Klimaneutralität an
                </span>
              </div>

              <div class="stat">
                <strong>04</strong>
                <span>
                  Technologiebereiche: Photovoltaik, Licht, Heizung und Speicherung
                </span>
              </div>

              <div class="stat">
                <strong>100%</strong>
                <span>
                  recycelbare Ausrichtung unserer Produkte
                </span>
              </div>
            </div>
          </div>

          <div class="instrument">
            <div class="instrument-layout">
              <span class="instrument-label">
                Gaia Matrix Technologies<br>
                Nanotechnologie / Energie / Zukunft
              </span>

              <div
                class="graphic"
                aria-label="Abstrakte Darstellung eines nanotechnologischen Energiesystems"
                role="img">
              </div>

              <span class="instrument-value">
                Nachhaltig<br>
                dezentral<br>
                autark
              </span>
            </div>
          </div>
        </div>
      </section>

      <!-- Vision -->
      <section class="section band">
        <div class="content">
          <div class="section-head">
            <div>
              <p class="meta">
                Unsere Vision / 02
              </p>

              <h2>
                Die Ära einer neuen grünen Form der Energiegewinnung.
              </h2>
            </div>

            <p>
              Basierend auf neuesten nanotechnologischen Erkenntnissen und
              Verfahren entwickelt Gaia Matrix Technologies Systeme, die
              Energiegewinnung und Energieversorgung neu denken.
              Weiterführende technische Unterlagen und Nachweise können
              interessierten Parteien im Rahmen eines NDA zur Verfügung
              gestellt werden.
            </p>
          </div>

          <div class="items three">
            <article class="item">
              <span class="meta">
                01 / Nachhaltigkeit
              </span>

              <h3>
                Energie mit Verantwortung.
              </h3>

              <p>
                Unsere Systeme sind auf Nachhaltigkeit, Umweltfreundlichkeit,
                Langlebigkeit, Effizienz und einen geringen CO₂-Ausstoß ausgerichtet.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                02 / Technologie
              </span>

              <h3>
                Gedruckte Nanotechnologie.
              </h3>

              <p>
                Patentierte und zertifizierte Systeme verbinden moderne
                Nanotechnologie mit einem klaren und skalierbaren Ansatz für
                die Energiegewinnung. Technische Details werden auf Anfrage
                im geschützten Rahmen vertieft.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                03 / Unabhängigkeit
              </span>

              <h3>
                Energie dort, wo sie gebraucht wird.
              </h3>

              <p>
                Dezentrale und autarke Energiesysteme schaffen neue Möglichkeiten
                für Gebäude, Infrastruktur und unseren Alltag.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- Technologies -->
      <section class="section" id="technologies">
        <div class="content">
          <div class="platform">
            <div class="platform-intro">
              <p class="meta">
                Technologien / 03
              </p>

              <h2>
                Vier Bereiche. Eine gemeinsame Vision.
              </h2>

              <p>
                Die von Gaia Matrix Technologies verwendete Nanotechnologie
                eröffnet neue Möglichkeiten in unterschiedlichen Bereichen
                der Energiegewinnung und Energieversorgung.
              </p>

              <p>
                Detaillierte technische Spezifikationen, Prüfunterlagen und
                weitere Evidenz werden qualifizierten Interessenten im Rahmen
                eines NDA zugänglich gemacht.
              </p>
            </div>

            <div class="list">
              <div class="row">
                <span>01 / Photovoltaik</span>
                <strong>
                  Gedruckte Systeme zur Erzeugung elektrischer Energie
                </strong>
              </div>

              <div class="row">
                <span>02 / Leuchttechnologie</span>
                <strong>
                  Nanotechnologische Lösungen für eine neue Form der Beleuchtung
                </strong>
              </div>

              <div class="row">
                <span>03 / Heizung</span>
                <strong>
                  Effiziente Systeme für eine nachhaltige Wärmeversorgung
                </strong>
              </div>

              <div class="row">
                <span>04 / Energiespeicherung</span>
                <strong>
                  Technologien für Speicherung und Nutzung selbst erzeugter Energie
                </strong>
              </div>

              <div class="row">
                <span>Materialien</span>
                <strong>
                  Ohne kritische oder seltene Erden
                </strong>
              </div>

              <div class="row">
                <span>Produktansatz</span>
                <strong>
                  Langlebig, schadstofffrei und vollständig recycelbar
                </strong>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Applications -->
      <section class="section" id="applications">
        <div class="content">
          <div class="section-head">
            <div>
              <p class="meta">
                Anwendungen / 04
              </p>

              <h2>
                Energie wird Teil unserer Umgebung.
              </h2>
            </div>

            <p>
              Unsere Energiesysteme können dazu beitragen, Gebäude,
              Infrastruktur und die Art, wie wir wohnen und arbeiten,
              nachhaltig zu verändern.
            </p>
          </div>

          <div class="items four">
            <article class="item">
              <span class="meta">
                A / Gebäude
              </span>

              <h3>
                Autarke Häuser
              </h3>

              <p>
                Photovoltaik und Energiespeicherung ermöglichen Gebäude,
                die ihren Energiebedarf weitgehend eigenständig decken können.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                B / Gewerbe
              </span>

              <h3>
                Gewerbliche Systeme
              </h3>

              <p>
                Dezentrale Energieversorgung für Unternehmen und gewerbliche
                Gebäude mit Fokus auf Effizienz und langfristige Kostenreduktion.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                C / Infrastruktur
              </span>

              <h3>
                Dezentrale Energie
              </h3>

              <p>
                Energieversorgung wird unabhängiger von zentralen Strukturen
                und damit resilienter gegenüber Krisen und Engpässen.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                D / Alltag
              </span>

              <h3>
                Neue Lebensräume
              </h3>

              <p>
                Unsere Produkte sollen ihren Einsatz dort finden, wo wir
                leben, arbeiten und Energie täglich benötigen.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- Independence -->
      <section class="section" id="independence">
        <div class="content">
          <div class="comparison">
            <div class="comparison-copy">
              <p class="meta">
                Energieunabhängigkeit / 05
              </p>

              <h2>
                Strategische Souveränität beginnt bei der Energie.
              </h2>

              <p>
                Die dezentralisierte, autarke Energieversorgung steht in
                unserem Fokus. Sie bedeutet strategische Souveränität und
                zugleich Unabhängigkeit von herkömmlicher Energieversorgung
                durch Gas, Öl oder Kohle.
              </p>

              <p>
                Eine resiliente Energieinfrastruktur kann dazu beitragen,
                dass Energie in Krisensituationen nicht länger als strategisches
                Druckmittel eingesetzt werden kann.
              </p>

              <p>
                Technische Nachweise und weiterführende Unterlagen zur
                Leistungsfähigkeit der Systeme können nach entsprechender
                Qualifizierung und unter NDA eingesehen werden.
              </p>
            </div>

            <div class="table">
              <table>
                <thead>
                  <tr>
                    <th>Dimension</th>
                    <th>Unser Ansatz</th>
                    <th>Ziel</th>
                  </tr>
                </thead>

                <tbody>
                  <tr>
                    <td>Versorgung</td>
                    <td class="positive">
                      Dezentral und autark
                    </td>
                    <td>
                      Höhere Resilienz
                    </td>
                  </tr>

                  <tr>
                    <td>Energiequellen</td>
                    <td class="positive">
                      Erneuerbare Energien
                    </td>
                    <td>
                      Weniger fossile Abhängigkeit
                    </td>
                  </tr>

                  <tr>
                    <td>Materialien</td>
                    <td class="positive">
                      Ohne kritische oder seltene Erden
                    </td>
                    <td>
                      Nachhaltigere Produktion
                    </td>
                  </tr>

                  <tr>
                    <td>Lebensdauer</td>
                    <td class="positive">
                      Langlebige Systeme
                    </td>
                    <td>
                      Nachhaltige Nutzung
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Quote -->
      <section class="section">
        <div class="content">
          <div class="quote">
            <blockquote>
              „Unsere Umwelt, unsere Infrastruktur, unsere Häuser sowie unsere
              Form des Wohnens werden sich durch diese Energiesysteme positiv verändern.“
            </blockquote>

            <cite>
              Gaia Matrix Technologies AG / Zukunftsvision
            </cite>
          </div>
        </div>
      </section>

      <!-- Sustainability -->
      <section class="section band">
        <div class="content">
          <div class="section-head">
            <div>
              <p class="meta">
                Material &amp; Effizienz / 06
              </p>

              <h2>
                Nachhaltigkeit beginnt bei den Materialien.
              </h2>
            </div>

            <p>
              Unsere Produkte kommen ohne kritische oder seltene Erden aus.
              Sie sind frei von Giftstoffen, langlebig, preiswert und auf
              einen geringen CO₂-Ausstoß sowie vollständige Recyclingfähigkeit
              ausgerichtet.
            </p>
          </div>

          <div class="items three">
            <article class="item">
              <span class="meta">
                01 / Ressourcen
              </span>

              <h3>
                Keine kritischen Erden.
              </h3>

              <p>
                Für die Herstellung unserer Produkte werden weder kritische
                noch seltene Erden eingesetzt.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                02 / Kreislauf
              </span>

              <h3>
                Recycelbar.
              </h3>

              <p>
                Unsere Systeme sind vollständig recycelbar und damit auf
                einen nachhaltigeren Produktlebenszyklus ausgerichtet.
              </p>
            </article>

            <article class="item">
              <span class="meta">
                03 / Wirtschaftlichkeit
              </span>

              <h3>
                Nachhaltig und wirtschaftlich.
              </h3>

              <p>
                Die Produkte sind preiswert und auf eine Amortisation des
                investierten Betrags innerhalb weniger Jahre ausgelegt.
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- Partners -->
      <section class="section">
        <div class="content">
          <div class="opportunity-layout">
            <div class="opportunity-copy">
              <p class="meta">
                Netzwerk / 07
              </p>

              <h2>
                Gemeinsam die Energiezukunft gestalten.
              </h2>

              <p>
                Mit unseren renommierten Partnern aus der Industrie sind wir
                international vernetzt. Wenn Sie integrativer Teil dieses
                Netzwerkes werden wollen, können wir gemeinsam die Zukunft
                unserer und nachfolgender Generationen sichern.
              </p>
            </div>

            <div class="opportunity-action">
              <a class="action secondary" href="#nda">
                Technische Unterlagen &rarr;
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Future -->
      <section class="section opportunity">
        <div class="content">
          <div class="opportunity-layout">
            <div class="opportunity-copy">
              <p class="meta">
                Zukunft / 08
              </p>

              <h2>
                Ein Quantensprung.
              </h2>

              <p>
                Unsere Nanotechnologie revolutioniert die Welt im Bereich der
                Energiegewinnung. Der Traum der Unabhängigkeit von fossilen
                Brennstoffen wird wahr.
              </p>

              <p>
                Wir sehen unseren Ansatz als Beginn einer Reise, auf die wir
                Sie als Kunden und/oder Investoren mitnehmen möchten.
              </p>

              <p>
                Zukunftsinvestitionen in Energieunabhängigkeit, Umweltschutz
                und Sicherheit sind auch und gerade für verantwortungsbewusste
                Investoren ein richtiger und lukrativer Schritt.
              </p>

              <p class="text-mono-small">
                Weiterführende technische Dokumentation und Evidenz sind
                für qualifizierte Interessenten nach Abschluss eines NDA verfügbar.
              </p>
            </div>

            <div class="opportunity-action">
              <a class="action primary" href="#nda">
                Zugang anfragen
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- NDA / Technical Evidence -->
      <section class="section" id="nda">
        <div class="content">
          <div class="nda">
            <div class="nda-intro">
              <p class="meta">
                Technische Evidenz / 09
              </p>

              <h2>
                Tiefer einsteigen. Unter NDA.
              </h2>

              <p>
                Wir stellen interessierten Investoren, Industriepartnern
                und qualifizierten Kooperationspartnern weiterführende
                technische Informationen und Nachweise im geschützten Rahmen
                zur Verfügung.
              </p>
            </div>

            <div class="points">
              <div class="point">
                <span>
                  01 / Technische Daten
                </span>
                <strong>
                  Weiterführende technische Spezifikationen und Produktinformationen
                  können nach Prüfung der Anfrage bereitgestellt werden.
                </strong>
              </div>

              <div class="point">
                <span>
                  02 / Nachweise
                </span>
                <strong>
                  Verfügbare Test-, Prüf-, Zertifizierungs- und Validierungsunterlagen
                  können im Rahmen des geschützten Informationsprozesses eingesehen werden.
                </strong>
              </div>

              <div class="point">
                <span>
                  03 / Geschäftsmodell
                </span>
                <strong>
                  Qualifizierte Interessenten können vertiefende Informationen
                  zu Anwendungen, Partnerschaften und kommerzieller Entwicklung erhalten.
                </strong>
              </div>

              <div class="point">
                <span>
                  04 / Vertraulichkeit
                </span>
                <strong>
                  Der Zugang zu vertraulichen Informationen erfolgt nach
                  entsprechender Prüfung und, soweit erforderlich, auf Basis
                  einer Vertraulichkeitsvereinbarung (NDA).
                </strong>
              </div>
            </div>
          </div>

          <!-- Form -->
          <div class="form-area">
            <div class="form-head">
              <div>
                <p class="meta">
                  Zugang anfragen
                </p>

                <h2>
                  Lassen Sie uns ins Gespräch kommen.
                </h2>
              </div>

              <p>
                Bitte teilen Sie uns einige Informationen zu Ihrer Organisation
                und Ihrem Interesse mit. Wir prüfen Ihre Anfrage und melden uns
                anschließend persönlich bei Ihnen.
              </p>
            </div>

            <form
              class="form"
              id="investor-form"
              action="#"
              method="POST"
            >
              <div class="field">
                <label for="name">
                  Name *
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                >
              </div>

              <div class="field">
                <label for="company">
                  Unternehmen / Organisation *
                </label>
                <input
                  id="company"
                  name="company"
                  type="text"
                  autocomplete="organization"
                  required
                >
              </div>

              <div class="field">
                <label for="email">
                  E-Mail *
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                >
              </div>

              <div class="field">
                <label for="country">
                  Land
                </label>
                <input
                  id="country"
                  name="country"
                  type="text"
                  autocomplete="country-name"
                >
              </div>

              <div class="field">
                <label for="type">
                  Organisationstyp *
                </label>
                <select
                  id="type"
                  name="organisation_type"
                  required
                >
                  <option value="" selected disabled>
                    Bitte auswählen
                  </option>
                  <option value="private-investor">
                    Privatinvestor
                  </option>
                  <option value="institutional-investor">
                    Institutioneller Investor
                  </option>
                  <option value="family-office">
                    Family Office
                  </option>
                  <option value="corporate">
                    Unternehmen / Industrie
                  </option>
                  <option value="technology-partner">
                    Technologiepartner
                  </option>
                  <option value="other">
                    Sonstige
                  </option>
                </select>
              </div>

              <div class="field">
                <label for="interest">
                  Interessensbereich *
                </label>
                <select
                  id="interest"
                  name="interest"
                  required
                >
                  <option value="" selected disabled>
                    Bitte auswählen
                  </option>
                  <option value="investment">
                    Investment
                  </option>
                  <option value="photovoltaics">
                    Photovoltaik
                  </option>
                  <option value="lighting">
                    Leuchttechnologie
                  </option>
                  <option value="heating">
                    Heizung
                  </option>
                  <option value="energy-storage">
                    Energiespeicherung
                  </option>
                  <option value="industrial-partnership">
                    Industriepartnerschaft
                  </option>
                  <option value="commercialisation">
                    Kommerzialisierung
                  </option>
                </select>
              </div>

              <div class="field">
                <label for="investment">
                  Investitions- / Kooperationsinteresse
                </label>
                <select
                  id="investment"
                  name="investment_interest"
                >
                  <option value="" selected>
                    Bitte auswählen
                  </option>
                  <option value="exploring">
                    Erste Orientierung
                  </option>
                  <option value="serious-interest">
                    Konkretes Interesse
                  </option>
                  <option value="strategic-partnership">
                    Strategische Partnerschaft
                  </option>
                  <option value="investment">
                    Investitionsgespräch
                  </option>
                  <option value="commercial-partnership">
                    Kommerzielle Zusammenarbeit
                  </option>
                </select>
              </div>

              <div class="field">
                <label for="website">
                  Website
                </label>
                <input
                  id="website"
                  name="website"
                  type="url"
                  autocomplete="url"
                  placeholder="https://"
                >
              </div>

              <div class="field full">
                <label for="message">
                  Nachricht
                </label>
                <textarea
                  id="message"
                  name="message"
                  placeholder="Beschreiben Sie kurz Ihr Interesse oder Ihre geplante Zusammenarbeit."
                ></textarea>
              </div>

              <div class="check">
                <input
                  id="nda-consent"
                  name="nda_interest"
                  type="checkbox"
                  value="yes"
                  required
                >
                <label for="nda-consent">
                  Ich möchte Informationen zu den verfügbaren technischen
                  Unterlagen und Nachweisen erhalten und verstehe, dass
                  vertrauliche Informationen gegebenenfalls erst nach
                  Abschluss einer NDA bereitgestellt werden.
                </label>
              </div>

              <div class="submit">
                <button
                  class="action primary"
                  type="submit"
                >
                  Anfrage senden
                </button>

                <p class="note">
                  Ihre Angaben werden zur Bearbeitung Ihrer Anfrage verwendet.
                  Bitte ergänzen Sie vor dem Livegang einen Link zu Ihrer
                  Datenschutzerklärung und passen Sie diesen Hinweis an Ihre
                  tatsächliche Datenverarbeitung an.
                </p>
              </div>
            </form>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="section" id="contact">
        <div class="content">
          <div class="section-head">
            <div>
              <p class="meta">
                Kontakt / 10
              </p>

              <h2>
                Die Richtung ist klar und steht fest.
              </h2>
            </div>

            <p>
              Wenn Sie Kunde, Investor oder integrativer Teil unseres
              internationalen Netzwerks werden möchten, freuen wir uns
              auf Ihre Kontaktaufnahme.
            </p>
          </div>

          <div class="contacts">
            <article class="contact">
              <span class="contact-role">
                CEO und Co-Gründerin
              </span>

              <h3>
                Gerlinde Jacobs
              </h3>

              <p class="address">
                GMT Gaia Matrix Technologies AG<br>
                Max-Högger-Strasse 6<br>
                8048 Zürich<br>
                Schweiz
              </p>
            </article>
          </div>
        </div>
      </section>

      <!-- Impressum -->
      <section class="section legal" id="impressum">
        <div class="content">
          <div class="legal-grid">
            <div class="legal-copy">
              <p class="meta">
                Impressum / 11
              </p>

              <h2>
                Rechtliches &amp; Impressum
              </h2>

              <p>
                GMT Gaia Matrix Technologies AG<br>
                Max-Högger-Strasse 6<br>
                8048 Zürich<br>
                Schweiz
              </p>

              <div class="actions" style="margin-top: 24px;">
                <a class="action secondary" href="/de/impressum">
                  Impressum &amp; Unternehmensangaben &rarr;
                </a>
                <a class="action ghost" href="/de/legal">
                  Datenschutzerklärung &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer currentLang="de" />
  </div>
</Layout>
