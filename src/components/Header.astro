---
import company from '../data/company.json';
import {
  DEFAULT_LANGUAGE,
  LANGUAGE_LABELS,
  LANGUAGE_SWITCHER_LABELS,
  SUPPORTED_LANGUAGES,
  getLocalizedPath,
  getSupportedLanguage,
} from '../data/languages.mjs';

interface Props {
  currentLang?: string;
}

type Language = keyof typeof LANGUAGE_LABELS;

const { currentLang = DEFAULT_LANGUAGE } = Astro.props;

const defaultLanguage = DEFAULT_LANGUAGE as Language;
const currentLanguage = getSupportedLanguage(currentLang) as Language;
const homePath = `/${currentLanguage}`;

const navLinksByLanguage = {
  de: [
      { href: `${homePath}#vision`, label: 'Vision' },
      { href: `${homePath}#technologies`, label: 'Technologien' },
      { href: `${homePath}#independence`, label: 'Energieunabhängigkeit' },
      { href: `${homePath}#nda`, label: 'Technische Evidenz' },
      { href: `${homePath}#contact`, label: 'Kontakt' },
    ],
  en: [
      { href: `${homePath}#vision`, label: 'Vision' },
      { href: `${homePath}#technologies`, label: 'Technologies' },
      { href: `${homePath}#independence`, label: 'Energy Independence' },
      { href: `${homePath}#nda`, label: 'Technical Evidence' },
      { href: `${homePath}#contact`, label: 'Contact' },
    ],
} as const;

const navLinks = navLinksByLanguage[currentLanguage] ?? navLinksByLanguage[defaultLanguage];
const languageSwitcherLabel = LANGUAGE_SWITCHER_LABELS[currentLanguage] ?? LANGUAGE_SWITCHER_LABELS[defaultLanguage];
const languageLinks = SUPPORTED_LANGUAGES.map((language) => {
  const languageCode = language as Language;

  return {
    href: getLocalizedPath(languageCode, Astro.url.pathname),
    isCurrent: languageCode === currentLanguage,
    label: LANGUAGE_LABELS[languageCode],
    language: languageCode,
  };
});
---

<header class="nav">
  <div class="content nav-inner">
    <a class="brand" href={`${homePath}#top`}>
      <span class="brand-mark" aria-hidden="true"></span>
      {company.brandName}
    </a>

    <ul class="nav-links">
      {navLinks.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>

    <nav class="language-switcher" aria-label={languageSwitcherLabel}>
      {languageLinks.map((link, index) => (
        <>
          {index > 0 && <span aria-hidden="true">/</span>}
          <a
            href={link.href}
            aria-current={link.isCurrent ? "page" : undefined}
            hreflang={link.language}
            lang={link.language}
            data-set-lang={link.language}
          >
            {link.label}
          </a>
        </>
      ))}
    </nav>
  </div>
</header>
