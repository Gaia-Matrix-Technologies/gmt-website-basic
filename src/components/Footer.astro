---
import company from '../data/company.json';
import {
  DEFAULT_LANGUAGE,
  LOCALIZED_CITY_NAMES,
  LOCALIZED_COUNTRY_NAMES,
  getSupportedLanguage,
} from '../data/languages.mjs';

interface Props {
  currentLang?: string;
}

type Language = keyof typeof LOCALIZED_COUNTRY_NAMES;

const { currentLang = DEFAULT_LANGUAGE } = Astro.props;
const currentLanguage = getSupportedLanguage(currentLang) as Language;
const homePath = `/${currentLanguage}`;

const footerContentByLanguage = {
  de: {
    brandDescription: "GMT entwickelt nanotechnologische Energiesysteme für Photovoltaik, Leuchttechnologie, Heizung und Speicherung.",
    headings: {
      navigation: "Navigation",
      legal: "Rechtliches",
      location: "Standort",
    },
    navigationLinks: [
      { href: `${homePath}#vision`, label: 'Vision' },
      { href: `${homePath}#technologies`, label: 'Technologien' },
      { href: `${homePath}#independence`, label: 'Energieunabhängigkeit' },
      { href: `${homePath}#nda`, label: 'Technische Evidenz' },
      { href: `${homePath}#contact`, label: 'Kontakt' },
    ],
    legalLinks: [
      { href: `/${currentLanguage}/impressum`, label: 'Impressum' },
      { href: `/${currentLanguage}/legal`, label: 'Datenschutzerklärung' },
    ],
    bottomTagline: "Energieunabhängigkeit / Nachhaltigkeit / Zukunft",
  },
  en: {
    brandDescription: "GMT develops nanotechnology-based energy systems for photovoltaics, lighting, heating, and energy storage.",
    headings: {
      navigation: "Navigation",
      legal: "Legal & Compliance",
      location: "Location",
    },
    navigationLinks: [
      { href: `${homePath}#vision`, label: 'Vision' },
      { href: `${homePath}#technologies`, label: 'Technologies' },
      { href: `${homePath}#independence`, label: 'Energy Independence' },
      { href: `${homePath}#nda`, label: 'Technical Evidence' },
      { href: `${homePath}#contact`, label: 'Contact' },
    ],
    legalLinks: [
      { href: `/${currentLanguage}/impressum`, label: 'Impressum' },
      { href: `/${currentLanguage}/legal`, label: 'Privacy Policy' },
    ],
    bottomTagline: "Energy Independence / Sustainability / Future",
  },
} as const;

const footerContent = footerContentByLanguage[currentLanguage as Language] ?? footerContentByLanguage[DEFAULT_LANGUAGE as Language];
const footerCity = LOCALIZED_CITY_NAMES[currentLanguage] ?? company.address.city;
const footerCountry = LOCALIZED_COUNTRY_NAMES[currentLanguage] ?? LOCALIZED_COUNTRY_NAMES[DEFAULT_LANGUAGE];
---

<footer class="footer-extensible">
  <div class="content">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-col brand-col">
        <a class="brand" href={`${homePath}#top`}>
          <span class="brand-mark" aria-hidden="true"></span>
          {company.brandName}
        </a>
        <p class="brand-desc">
          {footerContent.brandDescription}
        </p>
      </div>

      <!-- Navigation Column -->
      <div class="footer-col">
        <span class="footer-heading">{footerContent.headings.navigation}</span>
        <ul class="footer-links">
          {footerContent.navigationLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Legal & Compliance Column -->
      <div class="footer-col">
        <span class="footer-heading">{footerContent.headings.legal}</span>
        <ul class="footer-links">
          {footerContent.legalLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Location Column -->
      <div class="footer-col">
        <span class="footer-heading">{footerContent.headings.location}</span>
        <p class="footer-location">
          {company.legalName}<br />
          {company.address.street}<br />
          {company.address.postalCode} {footerCity}, {footerCountry}
        </p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} {company.displayName} / {footerCity}</span>
      <span>
        {footerContent.bottomTagline}
      </span>
    </div>
  </div>
</footer>

<style>
  .footer-extensible {
    border-top: 1px solid var(--divider);
    padding: 64px 0 36px;
    background: rgba(4, 8, 14, 0.6);
    position: relative;
    z-index: 1;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  .brand-col {
    padding-right: 20px;
  }

  .brand-desc {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
    margin-top: 16px;
    max-width: 320px;
  }

  .footer-heading {
    color: var(--cyan);
    display: block;
    font: 600 0.64rem/1.4 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    color: var(--muted-soft);
    font: 500 0.72rem/1.4 var(--mono);
    text-decoration: none;
    transition: color var(--ease);
  }

  .footer-links a:hover {
    color: var(--cyan-hot);
  }

  .footer-location {
    color: var(--muted-soft);
    font-size: 0.8rem;
    line-height: 1.65;
  }

  .footer-bottom {
    border-top: 1px solid var(--divider);
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--muted);
    font: 500 0.61rem/1.6 var(--mono);
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
  }
</style>

